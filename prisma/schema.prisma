// Prisma schema for the Noomie API.
// Docs: https://pris.ly/d/prisma-schema
//
// After editing models, create a migration with `npm run db:migrate -- --name <change>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased and trimmed, so uniqueness is case-insensitive.
  email        String    @unique @db.VarChar(254)
  displayName  String    @map("display_name") @db.VarChar(50)
  /// scrypt hash with its parameters; never returned by the API.
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  recipes      Recipe[]

  @@map("users")
}

/// One signed-in device. The client holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Recipe {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(2000)
  cuisine     String   @db.VarChar(60)
  minutes     Int
  ingredients String[]
  /// Set from the signed-in user when created, never from the request body, and never
  /// changed afterwards. Null for Noomie editorial recipes (seed data), which no user can edit.
  /// Restrict: deleting a user with recipes needs an explicit attribution decision first.
  authorId    String?  @map("author_id") @db.Uuid
  author      User?    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cuisine])
  @@index([authorId])
  @@map("recipes")
}
