# syntax=docker/dockerfile:1

# ---- base: shared runtime ---------------------------------------------------
FROM node:22-alpine AS base
# OpenSSL lets Prisma detect the platform and run its schema engine (migrations).
RUN apk add --no-cache openssl
WORKDIR /app
# Opt out of third-party install telemetry (swagger-ui-dist pulls in @scarf/scarf).
ENV SCARF_ANALYTICS=false

# ---- deps: all dependencies, Prisma Client generated by postinstall --------
FROM base AS deps
COPY package.json package-lock.json prisma7.config.ts ./
COPY prisma ./prisma
RUN npm ci

# ---- build: compile TypeScript; also used by the `migrate` compose service -
FROM deps AS build
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npm run build

# ---- prod-deps: runtime dependencies only ----------------------------------
FROM base AS prod-deps
COPY package.json package-lock.json ./
# --omit=optional drops the Prisma CLI and TypeScript, which @prisma/client lists
# as optional peers (the generated client is already compiled into dist/), and
# pg-cloudflare, which only Cloudflare Workers need.
RUN npm ci --omit=dev --omit=optional --ignore-scripts && npm cache clean --force

# ---- production: minimal runtime image -------------------------------------
FROM base AS production
ENV NODE_ENV=production
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/api/health" > /dev/null || exit 1
CMD ["node", "dist/main.js"]
