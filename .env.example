# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS (Expo web dev server: 8081, or 8082
# when Docker Desktop already holds 8081).
# Native iOS/Android apps are not subject to CORS. Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# Days a sign-in stays valid (1-365).
SESSION_TTL_DAYS=30

# --- PostgreSQL (docker compose) --------------------------------------------
POSTGRES_USER=noomie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noomie
# Host port for the database container. 5433 avoids clashing with a locally
# installed PostgreSQL on 5432.
POSTGRES_PORT=5433
# Host port for the API container started by `docker compose up`.
API_PORT=3000

# --- Prisma / API connection when running on your machine -------------------
# Must match the POSTGRES_* values above. URL-encode special characters in the
# password. Inside docker compose the API builds its own URL to host `postgres`.
DATABASE_URL=postgresql://noomie:change-me@localhost:5433/noomie
